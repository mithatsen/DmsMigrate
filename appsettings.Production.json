{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=your-oracle-server)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=ORCL)));User Id=dms_user;Password=YourSecurePassword123!;Connection Timeout=30;Pooling=true;Min Pool Size=5;Max Pool Size=100;"
  },
  "MigrationSettings": {
    "SourcePath": "\\\\network-share\\source-files",
    "TargetPath": "D:\\DMSFiles\\Production",
    "BatchSize": 500,
    "MaxRetryCount": 3,
    "StateFilePath": "migration-state-production.json",
    "ErrorLogPath": "Logs/migration-errors-production.log",
    "SupportedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".ppt",
      ".pptx",
      ".txt",
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".bmp",
      ".tiff",
      ".zip",
      ".rar",
      ".7z",
      ".csv",
      ".xml",
      ".json",
      ".msg",
      ".eml"
    ],
    "DefaultTenantId": 1,
    "DefaultCreatorUserId": 1,
    "UseDapper": true,
    "ParallelProcessing": false,
    "MaxDegreeOfParallelism": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "DMSMigration": "Information",
      "DMSMigration.Services.DocumentService": "Warning",
      "DMSMigration.Data.Repositories": "Warning"
    }
  }
}
